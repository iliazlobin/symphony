# Official image indexes verified with docker buildx imagetools inspect.
# Match Events Concierge CI: Python 3.12, Node 22, uv 0.11.29.
FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS node
FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/ /usr/local/lib/node_modules/

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git libatomic1 libstdc++6 ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && python -m pip install --no-cache-dir uv==0.11.29 \
    && python --version && node --version && uv --version

# npm checks package integrity; verify the reviewed top-level artifact explicitly.
RUN test "$(npm view @openai/codex@0.153.4 dist.integrity)" = "sha512-wbHDmit7S/YvBGVX1DQmk13xtWblZ2cApeJ/pB7xDZ10Cna+DZc5ij7f0F4OxdsXN4FW1oLT48OpogUI1+8Y2w==" \
    && npm install --global --ignore-scripts @openai/codex@0.153.4 \
    && npm cache clean --force \
    && codex --version

ENV HOME=/tmp/worker-home CODEX_HOME=/codex-home
WORKDIR /workspace
CMD ["codex", "app-server"]
