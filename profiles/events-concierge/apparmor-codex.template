# Symphony Codex 0.144.6 / pinned Debian worker image compatibility policy.
# Retains Docker 29.5.2 (moby 568f755) AppArmor permissions and proc/sys denials.
# Replaces the default mount denial with finite bubblewrap setup operations.
# The outer container still exposes only one assigned checkout, drops all
# capabilities, uses a read-only rootfs and the reviewed seccomp policy.
# Named Codex policies separately deny command network and protected-file reads.
# Generate with tools/worker_policy.py; never interpolate a task-supplied path.
abi <abi/3.0>,
#include <tunables/global>
profile "symphony-codex" flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  deny network alg,
  capability,
  file,
  umount,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer="symphony-codex",
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  mount options=(rw,silent,rslave) -> /,
  mount fstype=tmpfs options=(rw,nosuid,nodev) tmpfs -> /tmp/,
  mount options=(rw,rbind) /tmp/newroot/ -> /tmp/newroot/,
  mount fstype=tmpfs options=(rw,nosuid,nodev) tmpfs -> /newroot/,
  mount fstype=tmpfs options=(rw,nosuid,nodev) tmpfs -> /newroot/dev/,
  mount fstype=tmpfs options=(rw,nosuid,nodev) tmpfs -> /newroot/tmp/,
  mount options=(ro,nosuid,nodev,remount,bind,silent,relatime) -> /newroot/tmp/,
  pivot_root oldroot=/tmp/oldroot/ /tmp/,
  pivot_root oldroot=/newroot/ /newroot/,
  mount options=(rw,silent,rprivate) -> /oldroot/,
  mount options=(rw,rbind) /oldroot/dev/null -> /newroot/dev/null,
  mount options=(rw,rbind) /oldroot/dev/zero -> /newroot/dev/zero,
  mount options=(rw,rbind) /oldroot/dev/full -> /newroot/dev/full,
  mount options=(rw,rbind) /oldroot/dev/random -> /newroot/dev/random,
  mount options=(rw,rbind) /oldroot/dev/urandom -> /newroot/dev/urandom,
  mount options=(rw,rbind) /oldroot/dev/tty -> /newroot/dev/tty,
  mount fstype=devpts options=(rw,nosuid,noexec) devpts -> /newroot/dev/pts/,
  mount fstype=proc options=(rw,nosuid,nodev,noexec) proc -> /newroot/proc/,
  mount options=(rw,rbind) /oldroot/usr/bin/ -> /newroot/bin/,
  mount options=(ro,nosuid,nodev,remount,bind,silent,relatime) -> /newroot/bin/,
  mount options=(rw,rbind) /oldroot/usr/sbin/ -> /newroot/sbin/,
  mount options=(ro,nosuid,nodev,remount,bind,silent,relatime) -> /newroot/sbin/,
  mount options=(rw,rbind) /oldroot/usr/lib/ -> /newroot/lib/,
  mount options=(ro,nosuid,nodev,remount,bind,silent,relatime) -> /newroot/lib/,
  mount options=(rw,rbind) /oldroot/usr/lib64/ -> /newroot/lib64/,
  mount options=(ro,nosuid,nodev,remount,bind,silent,relatime) -> /newroot/lib64/,
  mount options=(rw,rbind) /oldroot/usr/ -> /newroot/usr/,
  mount options=(ro,nosuid,nodev,remount,bind,silent,relatime) -> /newroot/usr/,
  mount options=(rw,rbind) /oldroot/etc/ -> /newroot/etc/,
  mount options=(ro,nosuid,nodev,remount,bind,silent,relatime) -> /newroot/etc/,
  mount options=(ro,nosuid,nodev,remount,bind,silent,relatime) -> /newroot/etc/resolv.conf,
  mount options=(ro,nosuid,nodev,remount,bind,silent,relatime) -> /newroot/etc/hostname,
  mount options=(ro,nosuid,nodev,remount,bind,silent,relatime) -> /newroot/etc/hosts,
  mount options=(rw,rbind) /oldroot/usr/local/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-arm64/vendor/aarch64-unknown-linux-musl/codex-resources/zsh/bin/zsh -> /newroot/usr/local/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-arm64/vendor/aarch64-unknown-linux-musl/codex-resources/zsh/bin/zsh,
  mount options=(ro,nosuid,nodev,remount,bind,silent,relatime) -> /newroot/usr/local/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-arm64/vendor/aarch64-unknown-linux-musl/codex-resources/zsh/bin/zsh,
  mount options=(ro,nosuid,nodev,remount,bind,silent,relatime) -> /newroot/sbin/docker-init,
  mount options=(ro,nosuid,nodev,remount,bind,silent,relatime) -> /newroot/usr/sbin/docker-init,
  mount options=(rw,rbind) /oldroot/dev/pts/0 -> /newroot/dev/console,
@@WORKSPACE_RULES@@
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
  ptrace (trace,tracedby,read,readby) peer="symphony-codex",
}
